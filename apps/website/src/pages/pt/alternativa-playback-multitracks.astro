---
// Portuguese pair of the Playback comparison. Brazil is the fourth country by
// clicks with no Portuguese page; worship teams there search for Playback by
// name, so this is the comparison worth translating first.
import AlternativePage from "../../components/AlternativePage.astro";

const rows = [
