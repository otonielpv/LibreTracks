const strengths = [
  [
    "Suas faixas, sem mensalidade",
    "Se a sua equipe já produz as próprias faixas, ou compra músicas avulsas, o LibreTracks toca tudo com controles de palco sem somar uma assinatura.",
  ],
  [
    "Guia falada e contagem",
