---
import SiteLayout from "../layouts/SiteLayout.astro";
import GithubReleases from "../components/GithubReleases.astro";
---

<SiteLayout
  title="Download Free Multitrack Player | LibreTracks"
  description="Download LibreTracks for Windows, macOS and Linux. Free, open-source multitrack playback software with no account or subscription. Android is coming to Google Play."
  lang="en"
>
  <main class="site-shell band">
    <div class="section-heading">
      <p class="eyebrow">Downloads</p>
      <h1>Download LibreTracks free for Windows, macOS and Linux.</h1>
      <p>Installers are loaded from the public GitHub Releases API during the static build, so this page follows the current published version. On Android, LibreTracks installs from Google Play — see the note below.</p>
    </div>
    <GithubReleases lang="en" />
  </main>
</SiteLayout>
