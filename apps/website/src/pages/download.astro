---
import SiteLayout from "../layouts/SiteLayout.astro";
import GithubReleases from "../components/GithubReleases.astro";
---

<SiteLayout
  title="Download LibreTracks — Free Multitrack Player"
  description="Download LibreTracks free for Windows, macOS, Linux and Android. Open-source multitrack playback software for live shows, with no licence, account or subscription."
  lang="en"
>
  <main class="site-shell band">
    <div class="section-heading">
      <p class="eyebrow">Downloads</p>
      <h2>Download LibreTracks free for Windows, macOS, Linux and Android.</h2>
      <p>Installers are loaded from the public GitHub Releases API during the static build, so this page follows the current published version.</p>
    </div>
    <GithubReleases lang="en" />
  </main>
</SiteLayout>
