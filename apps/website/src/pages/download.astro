---
import SiteLayout from "../layouts/SiteLayout.astro";
import GithubReleases from "../components/GithubReleases.astro";
---

<SiteLayout
  title="Download Free Multitrack Player | LibreTracks"
  description="Download LibreTracks for Windows, macOS, Linux or Android. Free, open-source multitrack playback software with no account or subscription."
  lang="en"
>
  <main class="site-shell band">
    <div class="section-heading">
      <p class="eyebrow">Downloads</p>
      <h1>Download LibreTracks free for Windows, macOS, Linux and Android.</h1>
      <p>Installers are loaded from the public GitHub Releases API during the static build, so this page follows the current published version.</p>
    </div>
    <GithubReleases lang="en" />
  </main>
</SiteLayout>
