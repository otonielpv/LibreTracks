---
import SiteLayout from "../../layouts/SiteLayout.astro";
import GithubReleases from "../../components/GithubReleases.astro";
---

<SiteLayout
  title="Descargar Reproductor Multitrack Gratis | LibreTracks"
  description="Descarga LibreTracks para Windows, macOS, Linux o Android. Reproductor multitrack gratis y de código abierto, sin cuenta ni suscripción."
  lang="es"
>
  <main class="site-shell band">
    <div class="section-heading">
      <p class="eyebrow">Descargas</p>
      <h1>Descarga LibreTracks gratis para Windows, macOS, Linux y Android.</h1>
      <p>Los instaladores se cargan desde la API pública de GitHub Releases durante el build estático, así que esta página siempre muestra la versión publicada más reciente.</p>
    </div>
    <GithubReleases lang="es" />
  </main>
</SiteLayout>
