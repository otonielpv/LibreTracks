---
import SiteLayout from "../../layouts/SiteLayout.astro";
import GithubReleases from "../../components/GithubReleases.astro";
---

<SiteLayout
  title="Descargar LibreTracks Gratis — Reproductor Multitrack"
  description="Descarga LibreTracks gratis para Windows, macOS, Linux y Android. Reproductor multitrack de código abierto para tocar en directo, sin licencia, sin cuenta y sin suscripción."
  lang="es"
>
  <main class="site-shell band">
    <div class="section-heading">
      <p class="eyebrow">Descargas</p>
      <h2>Descarga LibreTracks gratis para Windows, macOS, Linux y Android.</h2>
      <p>Los instaladores se cargan desde la API pública de GitHub Releases durante el build estático, así que esta página siempre muestra la versión publicada más reciente.</p>
    </div>
    <GithubReleases lang="es" />
  </main>
</SiteLayout>
