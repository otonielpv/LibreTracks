---
import AlternativePage from "../components/AlternativePage.astro";

const rows = [
  [
    "Model",
    "Subscription service: you pay a fee for as long as you use it.",
    "Free and open-source software (AGPL-3.0). No fee, no account.",
  ],
  [
    "Where the tracks come from",
    "Their licensed multitrack catalogue, ready to play.",
    "Wherever you bring them from: bought, produced by your team, or exported from your DAW.",
  ],
  [
    "Where it runs",
    "Built mainly for tablet and phone.",
    "Windows, macOS, Linux and Android. The machine you already own will do.",
  ],
  [
    "Internet connection",
    "Catalogue and account live in the cloud.",
    "Everything is local. Once installed, it works offline.",
  ],
  [
    "Preparing the set",
    "Pick songs from the catalogue and adjust the instrumentation.",
    "Build the session from your own stems, markers, outputs and mix, then reuse it.",
  ],
  [
    "Guide vocals and click",
    "Included — one of its signature features.",
    "Included: spoken guide in English and Spanish, plus a metronome, each with its own output.",
  ],
  [
    "If you stop paying",
    "You lose access to the service.",
    "There is nothing to stop paying. The program and your sessions are yours.",
  ],
];

const strengths = [
  [
    "Your tracks, no monthly fee",
    "If your team already produces its own stems, or buys them individually, LibreTracks plays them with real live controls without adding a subscription on top.",
  ],
  [
    "Spoken guide vocals",
    "Announces the section coming up ('Chorus', 'Verse 2', 'Bridge') and counts the band in before the downbeat, plus spoken cues like 'Build' or 'Drums In' wherever you place them.",
  ],
  [
    "Per-song key changes",
    "Transpose a song to suit whoever is singing that week, and use the per-track T button to decide which stems follow the change.",
  ],
  [
    "Runs on the venue laptop",
    "A lightweight native desktop app with hardware outputs, MIDI Learn and a mobile remote for whoever is at the desk.",
  ],
];

const limits = [
  "LibreTracks has no track catalogue. If what you need is to download ready-made, licensed multitracks of well-known songs, that is exactly what Playback does and we do not.",
  "Here you supply the tracks. If your team neither produces nor buys multitracks, free software does not solve the underlying problem, which is sourcing the audio.",
  "Playback is highly polished on tablet and solves catalogue, preparation and playback in one go. LibreTracks gives you the player; the material and the prep are on you.",
  "If your team is happy on the subscription and nobody wants to touch the rig before Sunday, switching has a real cost in time and learning. Try it midweek, not at a dress rehearsal.",
];

const faq = [
  [
    "Is there a free alternative to Playback by MultiTracks?",
    "LibreTracks is a free, open-source alternative when you already have your own stems. It provides the player, click, spoken guide, key changes, MIDI and remote control, but it does not include a licensed song catalogue.",
  ],
  [
    "Does LibreTracks work without a Playback subscription?",
    "Yes. LibreTracks has no subscription or account and runs locally. Your sessions and audio remain on your device and can be used offline.",
  ],
  [
    "Can a worship team use its own multitracks?",
    "Yes. Import stems produced by your team, bought elsewhere or exported from a DAW, then configure markers, guide cues, click, song key and audio outputs for the set.",
  ],
];
---

<AlternativePage
  lang="en"
  rival="Playback"
  title="Free Alternative to Playback by MultiTracks | LibreTracks"
  description="Free, open-source alternative to Playback for worship teams: your own tracks, click, guide vocals, key changes and mobile control, offline and subscription-free."
  eyebrow="Free Playback alternative"
  heading="Free Playback by MultiTracks alternative for worship teams"
  intro="Playback solves two things at once: it gives you the multitrack catalogue and it gives you the player. If your team already has its stems — produced, bought, or exported from your own DAW — the only missing piece is the second one. LibreTracks is that second piece: spoken guide vocals, click, key changes, MIDI and a mobile remote, free and open source."
  heroImage="/screenshots/Voice-Guide-Settings.png"
  heroAlt="LibreTracks spoken guide vocal settings for live multitrack playback"
  rows={rows}
  strengths={strengths}
  limitsTitle="Where Playback does something we do not"
  limits={limits}
  faq={faq}
  closing="Take the stems for a song you already play, build the session with its section markers, and try it at a midweek rehearsal. It is free and works offline, so there is nothing to risk."
/>
