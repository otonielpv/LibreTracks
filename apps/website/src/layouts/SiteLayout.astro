---
import "../styles/fonts.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: "en" | "es" | "pt";
  noIndex?: boolean;
  /** Site-relative image for social previews. Defaults to the locale's card. */
  image?: string;
  /** Emit the SoftwareApplication schema (home pages only, to avoid duplicates). */
  schema?: boolean;
  /** Additional page-specific JSON-LD objects. */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, lang = "en", noIndex = false, image, schema = false, structuredData } = Astro.props;
const isSpanish = lang === "es";
const isPortuguese = lang === "pt";
// Pick the copy for the page language.
const L = (en: string, es: string, pt: string) => (isSpanish ? es : isPortuguese ? pt : en);
const socialCard = image ?? (isSpanish ? "/og-image.png" : "/og-image-en.png");
const prefix = isSpanish ? "/es" : isPortuguese ? "/pt" : "";
const sectionPrefix = prefix;

const currentPath = Astro.url.pathname;

// Landing pages that target search terms use a translated slug, so a plain
// `/es` prefix swap would point at a 404. Each row is one page in every
// language it exists in. Paths are stored without a trailing slash.
type Locale = "en" | "es" | "pt";
const PAGE_GROUPS: Partial<Record<Locale, string>>[] = [
  { en: "/", es: "/es", pt: "/pt" },
  { en: "/download", es: "/es/download", pt: "/pt/download" },
  { en: "/playback-multitracks-alternative", es: "/es/alternativa-playback-multitracks", pt: "/pt/alternativa-playback-multitracks" },
  { en: "/alternatives", es: "/es/alternativas", pt: "/pt/alternativas" },
  { en: "/ableton-live-alternative", es: "/es/alternativa-ableton-live", pt: "/pt/alternativa-ableton-live" },
  { en: "/reaper-live-alternative", es: "/es/alternativa-reaper-directo", pt: "/pt/alternativa-reaper-ao-vivo" },
  { en: "/prime-worship-alternative", es: "/es/alternativa-prime-worship", pt: "/pt/alternativa-prime-worship" },
  { en: "/ableset-alternative", es: "/es/alternativa-ableset", pt: "/pt/alternativa-ableset" },
  { en: "/guides", es: "/es/guias", pt: "/pt/guias" },
  { en: "/guides/run-backing-tracks-live", es: "/es/guias/lanzar-pistas-en-directo", pt: "/pt/guias/tocar-playback-ao-vivo" },
  { en: "/guides/multitrack-audio-routing", es: "/es/guias/salidas-audio-multitrack", pt: "/pt/guias/roteamento-audio-multitrack" },
  { en: "/guides/backing-track-software", es: "/es/guias/programa-secuencias-en-vivo", pt: "/pt/guias/programa-playback-ao-vivo" },
  { en: "/guides/free-multitracks", es: "/es/guias/multitracks-gratis", pt: "/pt/guias/multitracks-gratis" },
  // English only: the stats page has no Spanish twin to switch to.
  { en: "/download/stats" },
  { en: "/admin/analytics", es: "/es/admin/analytics" },
];

const bare = currentPath.replace(/\/$/, "") || "/";
const group = PAGE_GROUPS.find((row) => Object.values(row).includes(bare));
// Pages outside the table (privacy) exist in every locale under the same
// slug, so the counterpart is the locale prefix swapped in or out.
const neutralPath = currentPath.replace(/^\/(es|pt)(?=\/|$)/, "") || "/";
const alternates: Partial<Record<Locale, string>> = group ?? {
  en: neutralPath,
  es: neutralPath === "/" ? "/es/" : `/es${neutralPath}`,
  pt: neutralPath === "/" ? "/pt/" : `/pt${neutralPath}`,
};

// hreflang must point at the other page's canonical URL exactly, and canonicals
// here carry a trailing slash.
const withSlash = (path: string) => (path.endsWith("/") ? path : `${path}/`);
const LOCALE_NAMES: Record<Locale, string> = { en: "English", es: "Español", pt: "Português" };
const OG_LOCALES: Record<Locale, string> = { en: "en_US", es: "es_ES", pt: "pt_BR" };
// Every language this page exists in, current one included, for the header's
// language menu. A dropdown rather than inline links so a new locale is one
// more row, not one more item fighting for room in the header.
const languageLinks = (Object.keys(alternates) as Locale[]).map((code) => ({
  code,
  label: LOCALE_NAMES[code],
  href: withSlash(alternates[code]!),
  current: code === lang,
}));

// Canonical + hreflang. Without these Google treats / and /es/ as competing
// pages for the same product instead of locales of one page.
const site = Astro.site ?? new URL("https://libretracks.com");
const canonical = new URL(currentPath, site);
const hreflangs = (Object.keys(alternates) as Locale[]).map((code) => ({
  code,
  href: new URL(withSlash(alternates[code]!), site).href,
}));
const xDefault = new URL(withSlash(alternates.en ?? currentPath), site);
const ogImage = new URL(socialCard, site);

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "LibreTracks",
  applicationCategory: "MultimediaApplication",
  applicationSubCategory: L(
    "Multitrack playback software for live performance",
    "Reproductor multitrack para directo",
    "Player multitrack para tocar ao vivo",
  ),
  operatingSystem: "Windows, macOS, Linux, Android, iOS",
  description,
  url: canonical.href,
  downloadUrl: new URL(`${prefix}/download/`, site).href,
  image: ogImage.href,
  inLanguage: isSpanish ? "es" : isPortuguese ? "pt-BR" : "en",
  license: "https://www.gnu.org/licenses/agpl-3.0.html",
  isAccessibleForFree: true,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "EUR",
  },
  author: {
    "@type": "Person",
    name: "otonielpv",
    url: "https://github.com/otonielpv",
  },
};

// Google picks the site name it shows above the URL in search results from this
// schema first, ahead of og:site_name and the <title>. Without it the remaining
// signals are weak enough that a *.pages.dev subdomain gets labelled with the
// domain owner's brand ("Cloudflare") instead of ours.
// `url` is the site home, not the locale home, so the name applies to the whole
// site rather than to /es/ alone.
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "LibreTracks",
  url: site.href,
  // The profiles linked from the header, declared as the same entity. Google
  // uses these to tie the scattered LibreTracks accounts to this domain, which
  // matters most right after a domain move: they are the strongest signal we
  // control that the new host is the same project as the old one.
  sameAs: [
    "https://github.com/otonielpv/LibreTracks",
    "https://www.facebook.com/groups/1795788251804551",
    "https://www.reddit.com/r/LibreTracks/",
    "https://www.youtube.com/@LibreTracks",
  ],
};
const pageSchemas = structuredData
  ? (Array.isArray(structuredData) ? structuredData : [structuredData])
  : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0b0b" />
    {/* Ownership proof for Google Search Console. Must stay on every page and
        outside the noIndex guard: Google reads it wherever it lands, and
        removing it un-verifies the property. */}
    <meta name="google-site-verification" content="Flpzp-UREGKOBDVuAhhNDb-mbP-w5ilomf2lQEXhAaY" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    {noIndex && <meta name="referrer" content="no-referrer" />}
    {!noIndex && <link rel="canonical" href={canonical.href} />}
    {!noIndex && hreflangs.map(({ code, href }) => <link rel="alternate" hreflang={code} href={href} />)}
    {!noIndex && <link rel="alternate" hreflang="x-default" href={xDefault.href} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LibreTracks" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    {hreflangs.filter(({ code }) => code !== lang).map(({ code }) => (
      <meta property="og:locale:alternate" content={OG_LOCALES[code]} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <link rel="icon" href="/icon.svg" />
    {/* The two faces above the fold on every page: the body copy and the
        uppercase labels. Preloading them keeps the swap from landing after
        first paint, which is what makes a swap look like a layout jump. */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-400-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-800-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/space-grotesk-700-latin.woff2" crossorigin />
    {schema && !noIndex && (
      <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    )}
    {schema && !noIndex && (
      <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    )}
    {!noIndex && pageSchemas.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body>
    <div class="site-page">
      <a class="skip-link" href="#main-content">
        {L("Skip to content", "Saltar al contenido", "Pular para o conteúdo")}
      </a>
      <header class="site-header"><div class="site-shell site-nav">
        <a class="brand" href={`${prefix}/`}>
          <img src="/icon.svg" alt="" width="32" height="32" />
          <span translate="no">LibreTracks</span>
        </a>
        <nav class="nav-links" aria-label={L("Primary navigation", "Navegación principal", "Navegação principal")}>
          <a href={`${sectionPrefix}/docs/`}>{L("Docs", "Documentación", "Documentação")}</a>
          <a href={`${sectionPrefix}/${isSpanish || isPortuguese ? "guias" : "guides"}/`}>
            {L("Guides", "Guías", "Guias")}
          </a>
          <a href={`${sectionPrefix}/${isSpanish || isPortuguese ? "alternativas" : "alternatives"}/`}>
            {L("Alternatives", "Alternativas", "Alternativas")}
          </a>
          {languageLinks.length > 1 && (
            <details class="lang-menu" data-lang-menu>
              <summary aria-label={L("Language", "Idioma", "Idioma")}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm6.93 6h-2.95a15.6 15.6 0 0 0-1.38-3.56A8.03 8.03 0 0 1 18.93 8ZM12 4.04A13.8 13.8 0 0 1 13.91 8h-3.82A13.8 13.8 0 0 1 12 4.04ZM4.26 14a8.2 8.2 0 0 1 0-4h3.38a16.5 16.5 0 0 0 0 4H4.26Zm.81 2h2.95a15.6 15.6 0 0 0 1.38 3.56A8 8 0 0 1 5.07 16Zm2.95-8H5.07a8 8 0 0 1 4.33-3.56A15.6 15.6 0 0 0 8.02 8ZM12 19.96A13.8 13.8 0 0 1 10.09 16h3.82A13.8 13.8 0 0 1 12 19.96ZM14.34 14H9.66a14.7 14.7 0 0 1 0-4h4.68a14.7 14.7 0 0 1 0 4Zm.26 5.56A15.6 15.6 0 0 0 15.98 16h2.95a8.03 8.03 0 0 1-4.33 3.56ZM16.36 14a16.5 16.5 0 0 0 0-4h3.38a8.2 8.2 0 0 1 0 4h-3.38Z"
                  />
                </svg>
                <span>{lang.toUpperCase()}</span>
              </summary>
              <ul>
                {languageLinks.map(({ code, label, href, current }) => (
                  <li>
                    <a
                      class="lang-option"
                      href={href}
                      hreflang={code}
                      lang={code}
                      aria-current={current ? "page" : undefined}
                    >
                      {label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )}
          <a
            class="social-link"
            href="https://github.com/otonielpv/LibreTracks"
            aria-label="GitHub"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-1.05-.01-1.91-2.51.47-3.16-.63-3.36-1.2-.11-.29-.6-1.2-1.03-1.44-.35-.19-.85-.66-.01-.67.79-.01 1.35.74 1.54 1.05.9 1.55 2.34 1.11 2.91.85.09-.67.35-1.11.64-1.37-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.04 1.03-2.76-.1-.26-.45-1.31.1-2.72 0 0 .84-.28 2.75 1.05A9.28 9.28 0 0 1 12 6.96c.85 0 1.71.12 2.51.34 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.46.1 2.72.64.72 1.03 1.63 1.03 2.76 0 3.94-2.34 4.81-4.57 5.07.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.17 10.17 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"
              />
            </svg>
          </a>
          <a
            class="social-link"
            href="https://www.facebook.com/groups/1795788251804551"
            aria-label={L("Facebook group", "Grupo de Facebook", "Grupo no Facebook")}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.84c0-2.52 1.49-3.91 3.77-3.91 1.09 0 2.23.2 2.23.2v2.47h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.77l-.44 2.91h-2.33V22A10.04 10.04 0 0 0 22 12.06Z"
              />
            </svg>
          </a>
          <a
            class="social-link"
            href="https://www.reddit.com/r/LibreTracks/"
            aria-label={L("Reddit community", "Comunidad en Reddit", "Comunidade no Reddit")}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M14.41 16.87a3.38 3.38 0 0 1-2.37.63 3.37 3.37 0 0 1-2.36-.63 1 1 0 0 0-1.42 1.41 5.11 5.11 0 0 0 3.78 1.22 5.12 5.12 0 0 0 3.78-1.22 1 1 0 1 0-1.41-1.41ZM9.2 15a1 1 0 1 0-1-1 1 1 0 0 0 1 1Zm6-2a1 1 0 1 0 1 1 1 1 0 0 0-1-1Zm7.8-1.22a3.77 3.77 0 0 0-6.8-2.26 16.5 16.5 0 0 0-3.04-.48l.85-5.7 2.09.7a3 3 0 0 0 6-.06v-.02a3.03 3.03 0 0 0-3-2.96 2.98 2.98 0 0 0-2.34 1.16l-3.24-1.1a1 1 0 0 0-1.3.8l-1.09 7.17a16.66 16.66 0 0 0-3.34.49 3.77 3.77 0 0 0-6.22 4.23A4.86 4.86 0 0 0 1 16c0 3.92 4.83 7 11 7s11-3.08 11-7a4.86 4.86 0 0 0-.57-2.25 3.78 3.78 0 0 0 .57-1.97ZM19.1 3a1 1 0 1 1-1 1 1.02 1.02 0 0 1 1-1ZM4.77 10a1.76 1.76 0 0 1 .88.25A9.98 9.98 0 0 0 3 11.92v-.14A1.78 1.78 0 0 1 4.78 10ZM12 21c-4.88 0-9-2.29-9-5s4.12-5 9-5 9 2.29 9 5-4.12 5-9 5Zm8.99-9.08a9.98 9.98 0 0 0-2.65-1.67 1.76 1.76 0 0 1 .88-.25A1.78 1.78 0 0 1 21 11.78l-.01.14Z"
              />
            </svg>
          </a>
          <a
            class="social-link"
            href="https://www.youtube.com/@LibreTracks"
            aria-label={L("YouTube channel", "Canal de YouTube", "Canal no YouTube")}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M23.5 6.2A3 3 0 0 0 21.4 4c-1.9-.5-9.4-.5-9.4-.5s-7.5 0-9.4.5A3 3 0 0 0 .5 6.3C0 8 0 12 0 12s0 4 .5 5.8A3 3 0 0 0 2.6 20c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2c.5-2 .5-5.9.5-5.9s0-4-.5-5.8zm-14 9.4V8.4l6.3 3.6-6.3 3.6z"
              />
            </svg>
          </a>
          <a class="nav-cta" href={`${prefix}/download/`}>{L("Download", "Descargar", "Baixar")}</a>
        </nav>
      </div></header>
      <div id="main-content" tabindex="-1">
        <slot />
      </div>
      <footer class="site-footer">
        <div class="site-shell site-footer-inner">
          <div class="site-footer-brand">
            <a class="brand" href={`${prefix}/`}>
              <img src="/icon.svg" alt="" width="32" height="32" />
              <span translate="no">LibreTracks</span>
            </a>
            <p>
              {L(
                "Free multitrack playback for live performance. No account, no subscription, works offline.",
                "Reproductor multitrack libre para directo. Funciona sin cuenta, sin suscripción y sin conexión.",
                "Player multitrack gratuito para tocar ao vivo. Sem conta, sem assinatura e funciona offline.",
              )}
            </p>
          </div>
          <nav class="site-footer-links" aria-label={L("Footer navigation", "Enlaces del pie", "Links do rodapé")}>
            <a href={`${prefix}/download/`}>{L("Downloads", "Descargas", "Downloads")}</a>
            <a href={`${sectionPrefix}/docs/`}>{L("Docs", "Documentación", "Documentação")}</a>
            <a href={`${sectionPrefix}/${isSpanish || isPortuguese ? "guias" : "guides"}/`}>{L("Guides", "Guías", "Guias")}</a>
            <a href={`${sectionPrefix}/${isSpanish || isPortuguese ? "alternativas" : "alternatives"}/`}>
              {L("Alternatives", "Alternativas", "Alternativas")}
            </a>
            <a href={`${sectionPrefix}/privacy/`}>{L("Privacy", "Privacidad", "Privacidade")}</a>
            <a href="https://github.com/otonielpv/LibreTracks">{L("Source code", "Código fuente", "Código-fonte")}</a>
          </nav>
        </div>
        <div class="site-shell site-footer-legal">
          <p>© {new Date().getFullYear()} <span translate="no">LibreTracks</span></p>
          <p>
            {L("Released under the ", "Publicado bajo la licencia ", "Publicado sob a licença ")}
            <a href="https://www.gnu.org/licenses/agpl-3.0.html">AGPL-3.0</a>.
          </p>
        </div>
      </footer>
    </div>
    <script is:inline>
      (() => {
        // <details> opens and closes on its own; this only adds the two things
        // a dropdown is expected to do: close on a click outside and on Escape.
        const menu = document.querySelector("[data-lang-menu]");
        if (menu) {
          document.addEventListener("click", (event) => {
            if (menu.open && !menu.contains(event.target)) menu.open = false;
          });
          menu.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && menu.open) {
              menu.open = false;
              menu.querySelector("summary")?.focus();
            }
          });
        }
      })();
      (() => {
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

        // `autoplay` ignores prefers-reduced-motion, so the looping screen
        // recording has to be stopped here. Reading the query at runtime
        // (rather than dropping the element at build time) keeps the poster
        // frame in place for everyone.
        if (reduced.matches) {
          for (const video of document.querySelectorAll("video[autoplay]")) {
            video.autoplay = false;
            video.removeAttribute("loop");
            video.pause();
          }
        }

        // WCAG 2.2.2: any motion running past five seconds beside other
        // content needs a control to stop it — for every visitor, not only
        // the ones who set a reduced-motion preference.
        for (const button of document.querySelectorAll("[data-media-toggle]")) {
          const video = button.parentElement?.querySelector("video");
          if (!video) continue;

          const sync = () => {
            const paused = video.paused;
            button.setAttribute(
              "aria-label",
              paused ? button.dataset.labelPlay : button.dataset.labelPause,
            );
            const glyph = button.querySelector(".media-toggle-glyph");
            if (glyph) glyph.textContent = paused ? "▶" : "❚❚";
          };

          button.addEventListener("click", () => {
            if (video.paused) {
              const played = video.play();
              if (played) played.catch(() => {});
            } else {
              video.pause();
            }
          });
          video.addEventListener("play", sync);
          video.addEventListener("pause", sync);
          sync();
        }
      })();
    </script>
  </body>
</html>
