---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: "en" | "es";
  noIndex?: boolean;
  /** Site-relative image for social previews. Defaults to the locale's card. */
  image?: string;
  /** Emit the SoftwareApplication schema (home pages only, to avoid duplicates). */
  schema?: boolean;
}

const { title, description, lang = "en", noIndex = false, image, schema = false } = Astro.props;
const isSpanish = lang === "es";
const socialCard = image ?? (isSpanish ? "/og-image.png" : "/og-image-en.png");
const prefix = isSpanish ? "/es" : "";

// Language switch should stay on the equivalent page in the other language
// (e.g. /download ↔ /es/download), not jump back to the home page. Strip or
// add the `/es` prefix on the current path to build the counterpart URL.
const currentPath = Astro.url.pathname;

// Landing pages that target search terms use a translated slug, so the plain
// `/es` prefix swap below would point at a 404. Map those pairs explicitly.
// Keys and values are stored without a trailing slash.
const TRANSLATED_SLUGS: Record<string, string> = {
  "/ableton-live-alternative": "/es/alternativa-ableton-live",
  "/reaper-live-alternative": "/es/alternativa-reaper-directo",
  "/playback-multitracks-alternative": "/es/alternativa-playback-multitracks",
  "/prime-worship-alternative": "/es/alternativa-prime-worship",
};
const ES_TO_EN = Object.fromEntries(
  Object.entries(TRANSLATED_SLUGS).map(([en, es]) => [es, en]),
);

const bare = currentPath.replace(/\/$/, "") || "/";
let switchHref: string;
if (isSpanish) {
  // /es/download → /download ; /es or /es/ → /
  switchHref = ES_TO_EN[bare] ?? (currentPath.replace(/^\/es(?=\/|$)/, "") || "/");
} else {
  // /download → /es/download ; / → /es/
  switchHref =
    TRANSLATED_SLUGS[bare] ?? (currentPath === "/" ? "/es/" : `/es${currentPath}`);
}

// hreflang must point at the other page's canonical URL exactly, and canonicals
// here carry a trailing slash. The mapped slugs above are stored without one,
// so normalise before the URLs are built.
if (!switchHref.endsWith("/")) switchHref += "/";

// Canonical + hreflang. Without these Google treats /  and /es/ as competing
// pages for the same product instead of two locales of one page.
const site = Astro.site ?? new URL("https://libretracks.com");
const canonical = new URL(currentPath, site);
const altEn = new URL(isSpanish ? switchHref : currentPath, site);
const altEs = new URL(isSpanish ? currentPath : switchHref, site);
const ogImage = new URL(socialCard, site);

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "LibreTracks",
  applicationCategory: "MultimediaApplication",
  applicationSubCategory: isSpanish
    ? "Reproductor multitrack para directo"
    : "Multitrack playback software for live performance",
  operatingSystem: "Windows, macOS, Linux, Android",
  description,
  url: canonical.href,
  downloadUrl: new URL(`${prefix}/download/`, site).href,
  image: ogImage.href,
  inLanguage: isSpanish ? "es" : "en",
  license: "https://www.gnu.org/licenses/agpl-3.0.html",
  isAccessibleForFree: true,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "EUR",
  },
  author: {
    "@type": "Person",
    name: "otonielpv",
    url: "https://github.com/otonielpv",
  },
};

// Google picks the site name it shows above the URL in search results from this
// schema first, ahead of og:site_name and the <title>. Without it the remaining
// signals are weak enough that a *.pages.dev subdomain gets labelled with the
// domain owner's brand ("Cloudflare") instead of ours.
// `url` is the site home, not the locale home, so the name applies to the whole
// site rather than to /es/ alone.
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "LibreTracks",
  url: site.href,
  // The profiles linked from the header, declared as the same entity. Google
  // uses these to tie the scattered LibreTracks accounts to this domain, which
  // matters most right after a domain move: they are the strongest signal we
  // control that the new host is the same project as the old one.
  sameAs: [
    "https://github.com/otonielpv/LibreTracks",
    "https://www.facebook.com/groups/1795788251804551",
    "https://www.reddit.com/r/LibreTracks/",
    "https://www.youtube.com/@LibreTracks",
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Ownership proof for Google Search Console. Must stay on every page and
        outside the noIndex guard: Google reads it wherever it lands, and
        removing it un-verifies the property. */}
    <meta name="google-site-verification" content="Flpzp-UREGKOBDVuAhhNDb-mbP-w5ilomf2lQEXhAaY" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    {noIndex && <meta name="referrer" content="no-referrer" />}
    {!noIndex && <link rel="canonical" href={canonical.href} />}
    {!noIndex && <link rel="alternate" hreflang="en" href={altEn.href} />}
    {!noIndex && <link rel="alternate" hreflang="es" href={altEs.href} />}
    {!noIndex && <link rel="alternate" hreflang="x-default" href={altEn.href} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LibreTracks" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:locale" content={isSpanish ? "es_ES" : "en_US"} />
    <meta property="og:locale:alternate" content={isSpanish ? "en_US" : "es_ES"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <link rel="icon" href="/icon.svg" />
    {schema && !noIndex && (
      <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    )}
    {schema && !noIndex && (
      <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    )}
  </head>
  <body>
    <div class="site-page">
      <header class="site-shell site-nav">
        <a class="brand" href={`${prefix}/`}>
          <img src="/icon.svg" alt="" />
          <span>LibreTracks</span>
        </a>
        <nav class="nav-links" aria-label={isSpanish ? "Navegación principal" : "Primary navigation"}>
          <a href={`${prefix}/download/`}>{isSpanish ? "Descargas" : "Downloads"}</a>
          <a href={`${prefix}/docs/`}>{isSpanish ? "Documentación" : "Docs"}</a>
          <a href={switchHref} hreflang={isSpanish ? "en" : "es"}>{isSpanish ? "English" : "Español"}</a>
          <a
            class="social-link"
            href="https://github.com/otonielpv/LibreTracks"
            aria-label="GitHub"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-1.05-.01-1.91-2.51.47-3.16-.63-3.36-1.2-.11-.29-.6-1.2-1.03-1.44-.35-.19-.85-.66-.01-.67.79-.01 1.35.74 1.54 1.05.9 1.55 2.34 1.11 2.91.85.09-.67.35-1.11.64-1.37-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.04 1.03-2.76-.1-.26-.45-1.31.1-2.72 0 0 .84-.28 2.75 1.05A9.28 9.28 0 0 1 12 6.96c.85 0 1.71.12 2.51.34 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.46.1 2.72.64.72 1.03 1.63 1.03 2.76 0 3.94-2.34 4.81-4.57 5.07.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.17 10.17 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"
              />
            </svg>
          </a>
          <a
            class="social-link"
            href="https://www.facebook.com/groups/1795788251804551"
            aria-label={isSpanish ? "Grupo de Facebook" : "Facebook group"}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.84c0-2.52 1.49-3.91 3.77-3.91 1.09 0 2.23.2 2.23.2v2.47h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.77l-.44 2.91h-2.33V22A10.04 10.04 0 0 0 22 12.06Z"
              />
            </svg>
          </a>
          <a
            class="social-link"
            href="https://www.reddit.com/r/LibreTracks/"
            aria-label={isSpanish ? "Comunidad en Reddit" : "Reddit community"}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M14.41 16.87a3.38 3.38 0 0 1-2.37.63 3.37 3.37 0 0 1-2.36-.63 1 1 0 0 0-1.42 1.41 5.11 5.11 0 0 0 3.78 1.22 5.12 5.12 0 0 0 3.78-1.22 1 1 0 1 0-1.41-1.41ZM9.2 15a1 1 0 1 0-1-1 1 1 0 0 0 1 1Zm6-2a1 1 0 1 0 1 1 1 1 0 0 0-1-1Zm7.8-1.22a3.77 3.77 0 0 0-6.8-2.26 16.5 16.5 0 0 0-3.04-.48l.85-5.7 2.09.7a3 3 0 0 0 6-.06v-.02a3.03 3.03 0 0 0-3-2.96 2.98 2.98 0 0 0-2.34 1.16l-3.24-1.1a1 1 0 0 0-1.3.8l-1.09 7.17a16.66 16.66 0 0 0-3.34.49 3.77 3.77 0 0 0-6.22 4.23A4.86 4.86 0 0 0 1 16c0 3.92 4.83 7 11 7s11-3.08 11-7a4.86 4.86 0 0 0-.57-2.25 3.78 3.78 0 0 0 .57-1.97ZM19.1 3a1 1 0 1 1-1 1 1.02 1.02 0 0 1 1-1ZM4.77 10a1.76 1.76 0 0 1 .88.25A9.98 9.98 0 0 0 3 11.92v-.14A1.78 1.78 0 0 1 4.78 10ZM12 21c-4.88 0-9-2.29-9-5s4.12-5 9-5 9 2.29 9 5-4.12 5-9 5Zm8.99-9.08a9.98 9.98 0 0 0-2.65-1.67 1.76 1.76 0 0 1 .88-.25A1.78 1.78 0 0 1 21 11.78l-.01.14Z"
              />
            </svg>
          </a>
          <a
            class="social-link"
            href="https://www.youtube.com/@LibreTracks"
            aria-label={isSpanish ? "Canal de YouTube" : "YouTube channel"}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M23.5 6.2A3 3 0 0 0 21.4 4c-1.9-.5-9.4-.5-9.4-.5s-7.5 0-9.4.5A3 3 0 0 0 .5 6.3C0 8 0 12 0 12s0 4 .5 5.8A3 3 0 0 0 2.6 20c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2c.5-2 .5-5.9.5-5.9s0-4-.5-5.8zm-14 9.4V8.4l6.3 3.6-6.3 3.6z"
              />
            </svg>
          </a>
        </nav>
      </header>
      <slot />
    </div>
  </body>
</html>
