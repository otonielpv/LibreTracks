---
import SiteLayout from "../layouts/SiteLayout.astro";

interface Section {
  heading: string;
  paragraphs: string[];
  checklist?: string[];
  media?: {
    src: string;
    alt: string;
    width: number;
    height: number;
    type?: "image" | "video";
    poster?: string;
  };
}

interface RelatedLink {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  lang: "en" | "es" | "pt";
  eyebrow: string;
  heading: string;
  intro: string;
  hero: {
    src: string;
    alt: string;
    width: number;
    height: number;
  };
  sections: Section[];
  related: RelatedLink[];
  nextGuide?: RelatedLink;
}

const { title, description, lang, eyebrow, heading, intro, hero, sections, related, nextGuide } = Astro.props;
const isSpanish = lang === "es";
const isPortuguese = lang === "pt";
const prefix = isSpanish ? "/es" : isPortuguese ? "/pt" : "";
const hubSlug = isSpanish || isPortuguese ? "guias" : "guides";
const L = (en: string, es: string, pt: string) => (isSpanish ? es : isPortuguese ? pt : en);
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://libretracks.com");
const guidesUrl = new URL(`${prefix}/${hubSlug}/`, canonical);
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: heading,
    description,
    inLanguage: isPortuguese ? "pt-BR" : lang,
    mainEntityOfPage: canonical.href,
    author: {
      "@type": "Person",
      name: "otonielpv",
      url: "https://github.com/otonielpv",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: L("Guides", "Guías", "Guias"), item: guidesUrl.href },
      { "@type": "ListItem", position: 2, name: heading, item: canonical.href },
    ],
  },
];
---

<SiteLayout title={title} description={description} lang={lang} structuredData={structuredData}>
  <main class="site-shell band guide-page">
    <nav class="guide-breadcrumb" aria-label={L("Breadcrumb", "Migas de pan", "Navegação estrutural")}>
      <a href={`${prefix}/${hubSlug}/`}>
        <span aria-hidden="true">←</span> {L("All guides", "Todas las guías", "Todos os guias")}
      </a>
    </nav>

    <header class="guide-hero">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h1>{heading}</h1>
        <p>{intro}</p>
      </div>
      <figure>
        <img src={hero.src} alt={hero.alt} width={hero.width} height={hero.height} fetchpriority="high" decoding="async" />
      </figure>
    </header>

    <nav class="guide-toc" aria-label={L("Guide steps", "Pasos de la guía", "Passos do guia")}>
      {sections.map((section, index) => (
        <a href={`#step-${index + 1}`}><span>{index + 1}</span>{section.heading.replace(/^\d+\.\s*/, "")}</a>
      ))}
    </nav>

    <article class="guide-sections">
      {sections.map((section, index) => (
        <section class="guide-step" id={`step-${index + 1}`}>
          <div class="guide-step-copy">
            <span class="guide-step-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h2>{section.heading.replace(/^\d+\.\s*/, "")}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.checklist && (
              <ul class="guide-checklist">
                {section.checklist.map((item) => <li>{item}</li>)}
              </ul>
            )}
          </div>
          {section.media && (
            <figure class="guide-step-media">
              {section.media.type === "video" ? (
                <video controls muted playsinline preload="metadata" poster={section.media.poster} width={section.media.width} height={section.media.height} aria-label={section.media.alt}>
                  <source src={section.media.src} type={section.media.src.endsWith(".mp4") ? "video/mp4" : "video/webm"} />
                </video>
              ) : (
                <img src={section.media.src} alt={section.media.alt} width={section.media.width} height={section.media.height} loading="lazy" decoding="async" />
              )}
            </figure>
          )}
        </section>
      ))}
    </article>

    <aside class="guide-actions-panel">
      <div>
        <p class="eyebrow">{L("Put it into practice", "Ponlo en práctica", "Coloque em prática")}</p>
        <h2>{L("Prepare your first set", "Prepara tu primer repertorio", "Prepare seu primeiro repertório")}</h2>
        <p>{L("Download LibreTracks or open the exact documentation needed to configure this workflow.", "Descarga LibreTracks o abre la documentación exacta para configurar este flujo.", "Baixe o LibreTracks ou abra a documentação exata para configurar este fluxo.")}</p>
      </div>
      <div class="guide-action-links">
        {related.map((link, index) => (
          <a class={`button-link${index === 0 ? " primary" : ""}`} href={link.href}>
            {link.label} <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </aside>

    {nextGuide && (
      <nav class="guide-next" aria-label={L("Next guide", "Siguiente guía", "Próximo guia")}>
        <span>{L("Next guide", "Siguiente guía", "Próximo guia")}</span>
        <a href={nextGuide.href}>{nextGuide.label} <span aria-hidden="true">→</span></a>
      </nav>
    )}
  </main>
</SiteLayout>
