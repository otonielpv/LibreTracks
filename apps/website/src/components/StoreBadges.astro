---
interface Props {
  lang: "en" | "es";
}

const { lang } = Astro.props;
const isSpanish = lang === "es";

// Phones and tablets install only from the stores, so the download page shows
// the two listings as a single row of badges under the desktop installers.
// The Spanish page points at the Spanish App Store storefront; the English one
// uses the region-neutral URL so Apple redirects to the visitor's store.
const appStoreUrl = isSpanish
  ? "https://apps.apple.com/es/app/libretracks/id6811346212"
  : "https://apps.apple.com/app/libretracks/id6811346212";

// Google Play is the only Android install channel: a store build is signed
// with Google's key, so it cannot update a hand-installed APK, and offering
// both strands people on a build that never updates itself. The listing URL
// is derived from the applicationId (`com.libretracks.app`, see
// apps/desktop/src-tauri/gen/android/app/build.gradle.kts); `hl` only picks
// the language of the listing page, the store region follows the visitor.
const playStoreUrl = isSpanish
  ? "https://play.google.com/store/apps/details?id=com.libretracks.app&hl=es"
  : "https://play.google.com/store/apps/details?id=com.libretracks.app";

const copy = {
  label: isSpanish ? "LibreTracks para móvil y tablet" : "LibreTracks for phones and tablets",
  iosTop: isSpanish ? "Consíguelo en el" : "Download on the",
  iosAria: isSpanish ? "Descargar LibreTracks en el App Store" : "Download LibreTracks on the App Store",
  androidTop: isSpanish ? "Disponible en" : "Get it on",
  androidAria: isSpanish ? "Descargar LibreTracks en Google Play" : "Get LibreTracks on Google Play",
};
---

<nav class="store-badges" aria-label={copy.label}>
  <a class="store-badge" href={appStoreUrl} target="_blank" rel="noopener noreferrer" aria-label={copy.iosAria}>
    <svg class="store-badge-logo" viewBox="0 0 384 512" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z" />
    </svg>
    <span class="store-badge-text">
      <span class="store-badge-top">{copy.iosTop}</span>
      <span class="store-badge-name">App Store</span>
    </span>
  </a>
  <a class="store-badge" href={playStoreUrl} target="_blank" rel="noopener noreferrer" aria-label={copy.androidAria}>
    <svg class="store-badge-logo" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path fill="#00d7fe" d="M1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924z" />
      <path fill="#00f076" d="M13.544 10.989l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973z" />
      <path fill="#ff3a44" d="M13.544 13.056l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z" />
      <path fill="#ffd500" d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594z" />
    </svg>
    <span class="store-badge-text">
      <span class="store-badge-top">{copy.androidTop}</span>
      <span class="store-badge-name">Google Play</span>
    </span>
  </a>
</nav>
