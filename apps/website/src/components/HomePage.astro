---
import SiteLayout from "../layouts/SiteLayout.astro";
import StoreBadges from "./StoreBadges.astro";
import StoreProof from "./StoreProof.astro";
import { loadStoreStats } from "../lib/storeStats";
import "../styles/home.css";

// The locales used to be hand-synced copies of the same 200-line page.
// The markup lives here once; only the copy differs.
interface Props {
  lang: "en" | "es" | "pt";
}

const { lang } = Astro.props;
const storeStats = await loadStoreStats();
const proofLocale = lang === "es" ? "es-ES" : lang === "pt" ? "pt-BR" : "en-US";
const proofNumber = new Intl.NumberFormat(proofLocale, { useGrouping: "always" } as Intl.NumberFormatOptions);
const proofAverage = new Intl.NumberFormat(proofLocale, { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(storeStats.ratings.average);
const proofWords = lang === "es"
  ? { ratings: "valoraciones", downloads: "descargas", stars: "de 5 estrellas" }
  : lang === "pt"
  ? { ratings: "avaliações", downloads: "downloads", stars: "de 5 estrelas" }
  : { ratings: "ratings", downloads: "downloads", stars: "out of 5 stars" };
// Google shows stars in results only when the rating is visible on the page;
// this page shows it in the hero line and in StoreProof. ratingCount counts
// every rating, reviewCount only the ones with text.
const aggregateRating = storeStats.ratings.count > 0
  ? {
      "@type": "AggregateRating",
      ratingValue: Number(storeStats.ratings.average.toFixed(1)),
      bestRating: 5,
      worstRating: 1,
      ratingCount: storeStats.ratings.count,
      reviewCount: storeStats.reviews.count,
    }
  : undefined;
const es = lang === "es";
const pt = lang === "pt";
const prefix = es ? "/es" : pt ? "/pt" : "";
// Screenshots exist in English and Spanish only. The app has no Portuguese
// interface either, so the Portuguese page shows the English UI.
const docsPrefix = prefix;
const shots = `/screenshots/home/${es ? "es" : "en"}`;

