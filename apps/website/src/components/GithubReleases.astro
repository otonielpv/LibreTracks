---
import "../styles/download.css";
import { marked } from "marked";
import StoreBadges from "./StoreBadges.astro";
import { osIcons } from "./osIcons";

interface Props {
  owner?: string;
  repo?: string;
  lang?: "en" | "es";
}

type ReleaseAsset = {
  name: string;
  browser_download_url: string;
  size: number;
};

type Release = {
  tag_name: string;
  name: string | null;
  published_at: string | null;
  html_url: string;
  body: string | null;
  prerelease: boolean;
  draft: boolean;
  assets: ReleaseAsset[];
};

const { owner = "otonielpv", repo = "LibreTracks", lang = "en" } = Astro.props;
const isSpanish = lang === "es";

// Release bodies ship both the Spanish ("## Novedades de vX") and English
// ("## What's New in vX") sections. Show only the one matching the current
// page language so the panel isn't twice as tall as it needs to be. Mirrors
// `extractReleaseNotesForLanguage` in apps/desktop/src/shared/updateCheck.ts.
const SECTION_HEADINGS: Record<"es" | "en", RegExp[]> = {
  es: [/^#{1,3}\s*Novedades(?:\s+de)?\s+v?\d+\.\d+\.\d+/i, /^#{1,3}\s*Novedades/i, /^#{1,3}\s*Cambios/i],
  en: [/^#{1,3}\s*What['’]s\s+New\s+in\s+v?\d+\.\d+\.\d+/i, /^#{1,3}\s*What['’]s\s+New/i, /^#{1,3}\s*Changes/i, /^#{1,3}\s*Release\s+Notes/i],
};
const ANY_HEADING = /^#{1,3}\s+/;

function extractReleaseNotesForLanguage(body: string, language: "es" | "en"): string {
  if (!body) return "";
  const lines = body.split(/\r?\n/);
  const patterns = SECTION_HEADINGS[language];

  let startIndex = -1;
  for (let i = 0; i < lines.length; i += 1) {
    if (patterns.some((pattern) => pattern.test(lines[i]))) {
      startIndex = i;
      break;
    }
  }
  if (startIndex === -1) return body.trim();

  const collected: string[] = [lines[startIndex]];
  for (let i = startIndex + 1; i < lines.length; i += 1) {
    if (ANY_HEADING.test(lines[i])) break;
    collected.push(lines[i]);
  }
  return collected.join("\n").trim();
}

// Fetch the FULL release list (latest first). The page features the newest
// release but lets visitors switch to any previous version — older machines
// sometimes need the exact build that last worked for them, and it's nicer
// than hunting through GitHub's Releases tab.
const apiUrl = `https://api.github.com/repos/${owner}/${repo}/releases?per_page=100`;

let releases: Release[] = [];
let error: string | null = null;

try {
  const headers: HeadersInit = { Accept: "application/vnd.github+json" };
  // Añadimos el token si lo configuramos en Cloudflare
  if (import.meta.env.GITHUB_TOKEN) {
    headers["Authorization"] = `Bearer ${import.meta.env.GITHUB_TOKEN}`;
  }

  const response = await fetch(apiUrl, { headers });
  if (!response.ok) {
    throw new Error(`GitHub returned ${response.status}`);
  }
  const all = (await response.json()) as Release[];
  // Hide drafts; keep prereleases (clearly labelled) so testers can grab them.
  // Only app versions (v*): other releases mirror build dependencies.
  releases = all.filter((r) => !r.draft && r.tag_name.startsWith("v"));
} catch (caught) {
  error = caught instanceof Error ? caught.message : "Unknown error";
}

const labels = {
  currentVersion: isSpanish ? "Versión actual" : "Current version",
  latestBadge: isSpanish ? "Última" : "Latest",
  prereleaseBadge: isSpanish ? "Preliminar" : "Pre-release",
  published: isSpanish ? "Publicado" : "Published",
  assets: isSpanish ? "Instaladores" : "Installers",
  notes: isSpanish ? "Notas de la versión" : "Release notes",
  olderTitle: isSpanish ? "Versiones anteriores" : "Older versions",
  olderHint: isSpanish ? "Abre una versión en GitHub para ver sus instaladores y notas." : "Open a version on GitHub to see its installers and release notes.",
  supportTitle: isSpanish ? "Apoya LibreTracks" : "Support LibreTracks",
  supportText: isSpanish
    ? "LibreTracks es gratuito. Las donaciones voluntarias ayudan con mantenimiento, pruebas, documentación, releases y desarrollo continuo."
    : "LibreTracks is free. Voluntary donations help with maintenance, testing, documentation, releases, and ongoing development.",
  supportDisclaimer: isSpanish
    ? "La donación no desbloquea funciones, soporte prioritario, acceso anticipado ni compromisos de desarrollo."
    : "Donations do not unlock features, priority support, early access, or development commitments.",
  supportAction: isSpanish ? "Apoyar en Ko-fi" : "Support on Ko-fi",
  downloadThanks: isSpanish ? "Gracias por descargar LibreTracks." : "Thanks for downloading LibreTracks.",
  downloadSupportText: isSpanish
    ? "Si el proyecto te resulta útil, puedes apoyarlo con una donación voluntaria en Ko-fi."
    : "If the project is useful to you, you can support it with a voluntary donation on Ko-fi.",
  downloadClose: isSpanish ? "Ahora no, gracias" : "Not now, thanks",
  fallback: isSpanish
    ? "No se pudieron cargar las releases durante el build. Puedes abrir GitHub Releases directamente."
    : "Releases could not be loaded during the build. You can open GitHub Releases directly.",
  noAssets: isSpanish ? "Esta release no contiene instaladores publicados." : "This release has no published installers.",
  open: isSpanish ? "Abrir en GitHub" : "Open on GitHub",
  price: isSpanish ? "Precio" : "Price",
  free: isSpanish ? "Gratis" : "Free",
  license: isSpanish ? "Licencia" : "License",
  downloadFor: isSpanish ? "Descargar para" : "Download for",
  allInstallers: isSpanish ? "Todos los instaladores" : "All installers",
  perks: isSpanish
    ? ["Sin cuenta ni suscripción", "Funciona sin conexión", "Código abierto, licencia AGPL-3.0"]
    : ["No account, no subscription", "Works offline", "Open source, AGPL-3.0 licensed"],
  shotAlt: isSpanish
    ? "Vista Compacta de LibreTracks con una columna por canción y el mezclador"
    : "LibreTracks Compact View with one column per song and the mixer",
  mobile: isSpanish ? "Móvil y tablet" : "Phone and tablet",
  mobileNote: isSpanish
    ? "En iPhone, iPad y Android, LibreTracks se instala desde las tiendas."
    : "On iPhone, iPad, and Android, LibreTracks installs from the stores.",
};

// Android assets never reach the download cards. The APK is not a supported
// install channel any more (see StoreBadges.astro), and the AAB is the
// file that goes to Play Console — a visitor cannot install it at all.
// Filtering here also covers the older releases that still carry both.
const INSTALLER_ASSET = /\.(msi|exe|dmg|deb|appimage|rpm)$/i;

const releaseUrl = `https://github.com/${owner}/${repo}/releases`;
const donationUrl = "https://ko-fi.com/otonielpv";

function formatDate(value: string | null): string | null {
  if (!value) return null;
  return new Intl.DateTimeFormat(isSpanish ? "es" : "en", { dateStyle: "medium" }).format(new Date(value));
}

const sizeFormatter = new Intl.NumberFormat(isSpanish ? "es" : "en");

// What the file is, in words: a visitor picks ".deb · Debian, Ubuntu" faster
// than they parse `LibreTracks_1.16.0_amd64.deb`.
function describeAsset(name: string): string {
  if (/\.exe$/i.test(name)) return isSpanish ? "Instalador · .exe" : "Installer · .exe";
  if (/\.msi$/i.test(name)) return isSpanish ? "Instalador · .msi" : "Installer · .msi";
  if (/\.dmg$/i.test(name)) {
    return /universal/i.test(name) ? "Universal · .dmg" : isSpanish ? "Imagen de disco · .dmg" : "Disk image · .dmg";
  }
  if (/\.deb$/i.test(name)) return "Debian, Ubuntu · .deb";
  if (/\.rpm$/i.test(name)) return "Fedora, openSUSE · .rpm";
  if (/\.appimage$/i.test(name)) return isSpanish ? "Cualquier distro · AppImage" : "Any distro · AppImage";
  return name;
}

// Render only the current release in the page. Older release notes are useful
// to users but dilute the download page when shipped as hidden HTML, so older
// versions link to their permanent GitHub release pages.
const panels = await Promise.all(
  releases.slice(0, 1).map(async (release, index) => {
    const assets = release.assets.filter((asset) => INSTALLER_ASSET.test(asset.name));
    const localizedBody = release.body
      ? extractReleaseNotesForLanguage(release.body, isSpanish ? "es" : "en")
      : "";
    return {
      release,
      assets,
      index,
      isLatest: index === 0,
      date: formatDate(release.published_at),
      // The surrounding panel already labels this section. Demote headings
      // from release-authored Markdown so the document keeps one clear H1.
      bodyHtml: localizedBody
        ? await marked.parse(localizedBody.replace(/^#{1,3}\s+/gm, "#### "))
        : null,
    };
  }),
);

const latest = panels[0];

const PLATFORMS = [
  { id: "windows", name: "Windows", match: /\.(exe|msi)$/i },
  { id: "macos", name: "macOS", match: /\.dmg$/i },
  { id: "linux", name: "Linux", match: /\.(deb|rpm|appimage)$/i },
];
// The installer the big button offers for each system: the one that works
// for the most people on it.
const PREFERRED = [/\.exe$/i, /\.msi$/i, /\.dmg$/i, /\.appimage$/i, /\.deb$/i];
const platforms = PLATFORMS.map((platform) => {
  const assets = latest ? latest.assets.filter((asset) => platform.match.test(asset.name)) : [];
  const primary = PREFERRED.map((kind) => assets.find((asset) => kind.test(asset.name))).find(Boolean);
  return { ...platform, assets, primary };
});
const mains = platforms.flatMap((platform) =>
  platform.primary ? [{ ...platform, primary: platform.primary }] : [],
);

function megabytes(bytes: number): string {
  return `${sizeFormatter.format(Math.max(1, Math.round(bytes / 1024 / 1024)))}\u00a0MB`;
}

function extension(name: string): string {
  return /\.appimage$/i.test(name) ? "AppImage" : name.slice(name.lastIndexOf("."));
}
---

<section class="dl">
  {latest ? (
    <>
      {/* One big button for the visitor's own system. Every desktop button is
          in the page; the script below shows the right one, and without
          JavaScript the first stays visible with the full list underneath. */}
      <div class="dl-hero">
        <div class="dl-hero-action">
        {mains.map((platform) => (
          <a
            class="dl-main"
            data-main={platform.id}
            hidden={platform.id !== mains[0].id}
            href={platform.primary.browser_download_url}
            target="_blank"
            rel="noopener noreferrer"
            data-download-asset
          >
            <svg class="dl-main-os" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={osIcons[platform.id]} />
            <span class="dl-main-text">
              <span class="dl-main-label">{labels.downloadFor} {platform.name}</span>
              <span class="dl-main-meta">
                {latest.release.tag_name} · {megabytes(platform.primary.size)} · {extension(platform.primary.name)}
              </span>
            </span>
            <svg class="dl-ico dl-main-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M6.5 11 12 16.5 17.5 11M5 20h14" /></svg>
          </a>
        ))}
        <div class="dl-main-mobile" data-main="mobile" hidden>
          <p>{labels.mobileNote}</p>
          <StoreBadges lang={lang} />
        </div>
        {latest.date ? <p class="dl-hero-note">{labels.published}: {latest.date}</p> : null}
        <ul class="dl-perks">
          {labels.perks.map((perk) => (
            <li><svg class="dl-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>{perk}</li>
          ))}
        </ul>
        </div>
        <img
          class="dl-hero-shot"
          src={`/screenshots/home/${lang}/compact.webp`}
          alt={labels.shotAlt}
          width="1200"
          height="750"
          decoding="async"
        />
      </div>

      <div class="dl-all">
        <h2>{labels.allInstallers}</h2>
        <dl>
          {platforms.map((platform) => (
            <div>
              <dt><svg class="dl-os" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={osIcons[platform.id]} />{platform.name}</dt>
              <dd>
                {platform.assets.length > 0 ? platform.assets.map((asset) => (
                  <a class="dl-file" href={asset.browser_download_url} target="_blank" rel="noopener noreferrer" data-download-asset title={asset.name}>
                    <svg class="dl-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M6.5 11 12 16.5 17.5 11M5 20h14" /></svg>
                    {describeAsset(asset.name)}
                    <span>{megabytes(asset.size)}</span>
                  </a>
                )) : <span class="dl-empty">{labels.noAssets}</span>}
              </dd>
            </div>
          ))}
          <div>
            <dt><svg class="dl-os" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={osIcons.mobile} />{labels.mobile}</dt>
            <dd><StoreBadges lang={lang} /></dd>
          </div>
        </dl>
        <p class="dl-source">
          <a href={latest.release.html_url}>{labels.open}<span aria-hidden="true">→</span></a>
        </p>
      </div>

      {latest.bodyHtml ? (
        <details class="dl-fold">
          <summary><svg class="dl-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6" /></svg>{labels.notes} <span>{latest.release.tag_name}</span></summary>
          <div class="release-notes-body" set:html={latest.bodyHtml} />
        </details>
      ) : null}

      {releases.length > 1 ? (
        <details class="dl-fold">
          <summary><svg class="dl-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 12a8.5 8.5 0 1 0 2.6-6.1M3.5 4.5v4h4M12 7.5V12l3 2" /></svg>{labels.olderTitle} <span>{releases.length - 1}</span></summary>
          <p class="older-hint">{labels.olderHint}</p>
          <div class="version-chip-list">
            {releases.slice(1).map((release) => (
              <a
                class="version-chip"
                href={release.html_url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {release.tag_name}
                {release.prerelease ? <span class="version-chip-tag pre">{labels.prereleaseBadge}</span> : null}
              </a>
            ))}
          </div>
        </details>
      ) : null}

      <aside class="support-panel" aria-labelledby="support-title">
        <div>
          <h2 id="support-title">{labels.supportTitle}</h2>
          <p>{labels.supportText}</p>
          <p class="support-disclaimer">{labels.supportDisclaimer}</p>
        </div>
        <a class="button-link" href={donationUrl} target="_blank" rel="noopener noreferrer"><svg class="dl-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z" /></svg>{labels.supportAction}</a>
      </aside>
    </>
  ) : (
    <div>
      <p>{labels.fallback}</p>
      {error ? <p style="color: #ffe2ab;">{error}</p> : null}
      <div class="hero-actions">
        <a class="button-link primary" href={releaseUrl}>{labels.open}</a>
      </div>
      <StoreBadges lang={lang} />
    </div>
  )}
</section>

<dialog class="donation-dialog" data-donation-dialog>
  <div class="donation-dialog-body">
    <h3>{labels.downloadThanks}</h3>
    <p>{labels.downloadSupportText}</p>
    <p class="support-disclaimer">{labels.supportDisclaimer}</p>
    <div class="donation-dialog-actions">
      <a class="button-link primary" href={donationUrl} target="_blank" rel="noopener noreferrer" data-donation-close><span aria-hidden="true">☕</span> {labels.supportAction}</a>
      <button type="button" class="button-link" data-donation-close>{labels.downloadClose}</button>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector("[data-donation-dialog]");

  function showDonationReminder() {
    if (!(dialog instanceof HTMLDialogElement) || dialog.open) return;
    dialog.showModal();
  }

  function bindDownloadLinks() {
    document.querySelectorAll<HTMLAnchorElement>("[data-download-asset]").forEach((link) => {
      if (link.dataset.bound === "1") return;
      link.dataset.bound = "1";
      link.addEventListener("click", (event) => {
        if (!(link instanceof HTMLAnchorElement)) return;
        if (event.defaultPrevented) return;
        // Modifier-clicks / middle-click open in a new tab — let the browser
        // handle them without intercepting.
        const mouseEvent = event as MouseEvent;
        if (mouseEvent.button !== 0 || mouseEvent.metaKey || mouseEvent.ctrlKey || mouseEvent.shiftKey || mouseEvent.altKey) return;
        // Following the download URL in the same tab can move the page away
        // before the modal paints. Keep LibreTracks open, show the reminder,
        // and let the browser handle the GitHub asset separately.
        event.preventDefault();
        showDonationReminder();
        window.open(link.href, "_blank", "noopener,noreferrer");
      });
    });
  }

  bindDownloadLinks();

  // Show the big button for the system the visitor is on. Purely a
  // shortcut: every installer is listed right below whatever this guesses.
  const agent = navigator.userAgent;
  const system = /android|iphone|ipad|ipod/i.test(agent) || (/macintosh/i.test(agent) && navigator.maxTouchPoints > 1)
    ? "mobile"
    : /windows/i.test(agent)
      ? "windows"
      : /macintosh|mac os x/i.test(agent)
        ? "macos"
        : /linux|x11/i.test(agent)
          ? "linux"
          : null;
  const mains = document.querySelectorAll<HTMLElement>("[data-main]");
  if (system && [...mains].some((main) => main.dataset.main === system)) {
    mains.forEach((main) => {
      main.hidden = main.dataset.main !== system;
    });
  }

  const closeButtons = document.querySelectorAll("[data-donation-close]");
  closeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      if (dialog instanceof HTMLDialogElement) dialog.close();
    });
  });

  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) {
      dialog.close();
    }
  });
</script>
