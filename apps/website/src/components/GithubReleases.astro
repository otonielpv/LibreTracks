---
import { marked } from "marked";

interface Props {
  owner?: string;
  repo?: string;
  lang?: "en" | "es";
}

type ReleaseAsset = {
  name: string;
  browser_download_url: string;
  size: number;
};

type Release = {
  tag_name: string;
  name: string | null;
  published_at: string | null;
  html_url: string;
  body: string | null;
  prerelease: boolean;
  draft: boolean;
  assets: ReleaseAsset[];
};

const { owner = "otonielpv", repo = "LibreTracks", lang = "en" } = Astro.props;
const isSpanish = lang === "es";

// Release bodies ship both the Spanish ("## Novedades de vX") and English
// ("## What's New in vX") sections. Show only the one matching the current
// page language so the panel isn't twice as tall as it needs to be. Mirrors
// `extractReleaseNotesForLanguage` in apps/desktop/src/shared/updateCheck.ts.
const SECTION_HEADINGS: Record<"es" | "en", RegExp[]> = {
  es: [/^#{1,3}\s*Novedades(?:\s+de)?\s+v?\d+\.\d+\.\d+/i, /^#{1,3}\s*Novedades/i, /^#{1,3}\s*Cambios/i],
  en: [/^#{1,3}\s*What['’]s\s+New\s+in\s+v?\d+\.\d+\.\d+/i, /^#{1,3}\s*What['’]s\s+New/i, /^#{1,3}\s*Changes/i, /^#{1,3}\s*Release\s+Notes/i],
};
const ANY_HEADING = /^#{1,3}\s+/;

function extractReleaseNotesForLanguage(body: string, language: "es" | "en"): string {
  if (!body) return "";
  const lines = body.split(/\r?\n/);
  const patterns = SECTION_HEADINGS[language];

  let startIndex = -1;
  for (let i = 0; i < lines.length; i += 1) {
    if (patterns.some((pattern) => pattern.test(lines[i]))) {
      startIndex = i;
      break;
    }
  }
  if (startIndex === -1) return body.trim();

  const collected: string[] = [lines[startIndex]];
  for (let i = startIndex + 1; i < lines.length; i += 1) {
    if (ANY_HEADING.test(lines[i])) break;
    collected.push(lines[i]);
  }
  return collected.join("\n").trim();
}

// Fetch the FULL release list (latest first). The page features the newest
// release but lets visitors switch to any previous version — older machines
// sometimes need the exact build that last worked for them, and it's nicer
// than hunting through GitHub's Releases tab.
const apiUrl = `https://api.github.com/repos/${owner}/${repo}/releases?per_page=100`;

let releases: Release[] = [];
let error: string | null = null;

try {
  const headers: HeadersInit = { Accept: "application/vnd.github+json" };
  // Añadimos el token si lo configuramos en Cloudflare
  if (import.meta.env.GITHUB_TOKEN) {
    headers["Authorization"] = `Bearer ${import.meta.env.GITHUB_TOKEN}`;
  }

  const response = await fetch(apiUrl, { headers });
  if (!response.ok) {
    throw new Error(`GitHub returned ${response.status}`);
  }
  const all = (await response.json()) as Release[];
  // Hide drafts; keep prereleases (clearly labelled) so testers can grab them.
  releases = all.filter((r) => !r.draft);
} catch (caught) {
  error = caught instanceof Error ? caught.message : "Unknown error";
}

const labels = {
  currentVersion: isSpanish ? "Versión actual" : "Current version",
  latestBadge: isSpanish ? "Última" : "Latest",
  prereleaseBadge: isSpanish ? "Preliminar" : "Pre-release",
  published: isSpanish ? "Publicado" : "Published",
  assets: isSpanish ? "Instaladores" : "Installers",
  notes: isSpanish ? "Notas de la versión" : "Release notes",
  olderTitle: isSpanish ? "Versiones anteriores" : "Older versions",
  olderHint: isSpanish ? "Abre una versión en GitHub para ver sus instaladores y notas." : "Open a version on GitHub to see its installers and release notes.",
  supportTitle: isSpanish ? "Apoya LibreTracks" : "Support LibreTracks",
  supportText: isSpanish
    ? "LibreTracks es gratuito. Las donaciones voluntarias ayudan con mantenimiento, pruebas, documentación, releases y desarrollo continuo."
    : "LibreTracks is free. Voluntary donations help with maintenance, testing, documentation, releases, and ongoing development.",
  supportDisclaimer: isSpanish
    ? "La donación no desbloquea funciones, soporte prioritario, acceso anticipado ni compromisos de desarrollo."
    : "Donations do not unlock features, priority support, early access, or development commitments.",
  supportAction: isSpanish ? "Apoyar en Ko-fi" : "Support on Ko-fi",
  downloadThanks: isSpanish ? "Gracias por descargar LibreTracks." : "Thanks for downloading LibreTracks.",
  downloadSupportText: isSpanish
    ? "Si el proyecto te resulta útil, puedes apoyarlo con una donación voluntaria en Ko-fi."
    : "If the project is useful to you, you can support it with a voluntary donation on Ko-fi.",
  downloadClose: isSpanish ? "Ahora no, gracias" : "Not now, thanks",
  fallback: isSpanish
    ? "No se pudieron cargar las releases durante el build. Puedes abrir GitHub Releases directamente."
    : "Releases could not be loaded during the build. You can open GitHub Releases directly.",
  noAssets: isSpanish ? "Esta release no contiene instaladores publicados." : "This release has no published installers.",
  open: isSpanish ? "Abrir en GitHub" : "Open on GitHub",
  // Android is not on this page any more: it ships through Google Play and
  // nothing else. A store build is signed with Google's key, so it cannot
  // update a hand-installed APK — offering both channels at once strands
  // people on a build that never updates itself. Until the listing is public
  // this note is the whole Android story; when it goes live, replace it with
  // the official badge and the listing URL.
  androidTitle: isSpanish ? "Android: en breve en Google Play" : "Android: coming soon on Google Play",
  androidBody: isSpanish
    ? "LibreTracks para Android llega en breve a Google Play, y la tienda será la única forma de instalarlo: aquí ya no se publica el archivo APK. La aplicación de la tienda se actualiza sola en cuanto sale una versión nueva; la que se instalaba a mano, no."
    : "LibreTracks for Android is coming to Google Play shortly, and the listing will be the only way to install it: the APK is no longer published here. The store build updates itself as soon as a new version ships; a hand-installed one does not.",
};

// Android assets never reach the download cards. The APK is not a supported
// install channel any more (see `androidTitle` above), and the AAB is the
// file that goes to Play Console — a visitor cannot install it at all.
// Filtering here also covers the older releases that still carry both.
const STORE_ONLY_ASSET = /\.(apk|aab)$/i;

const releaseUrl = `https://github.com/${owner}/${repo}/releases`;
const donationUrl = "https://ko-fi.com/otonielpv";

function formatDate(value: string | null): string | null {
  if (!value) return null;
  return new Intl.DateTimeFormat(isSpanish ? "es" : "en", { dateStyle: "medium" }).format(new Date(value));
}

const sizeFormatter = new Intl.NumberFormat(isSpanish ? "es" : "en");

function iconForAsset(name: string): string {
  if (/\.msi$|\.exe$/i.test(name)) return "🪟";
  if (/\.dmg$/i.test(name)) return "🍎";
  if (/\.deb$|\.AppImage$|\.rpm$/i.test(name)) return "🐧";
  if (/\.apk$/i.test(name)) return "🤖";
  return "📦";
}

// Render only the current release in the page. Older release notes are useful
// to users but dilute the download page when shipped as hidden HTML, so older
// versions link to their permanent GitHub release pages.
const panels = await Promise.all(
  releases.slice(0, 1).map(async (release, index) => {
    const assets = release.assets.filter((asset) => !STORE_ONLY_ASSET.test(asset.name));
    const localizedBody = release.body
      ? extractReleaseNotesForLanguage(release.body, isSpanish ? "es" : "en")
      : "";
    return {
      release,
      assets,
      index,
      isLatest: index === 0,
      date: formatDate(release.published_at),
      // The surrounding panel already labels this section. Demote headings
      // from release-authored Markdown so the document keeps one clear H1.
      bodyHtml: localizedBody
        ? await marked.parse(localizedBody.replace(/^#{1,3}\s+/gm, "#### "))
        : null,
    };
  }),
);
---

<section class="download-panel">
  {panels.length > 0 ? (
    <>
      {panels.map((panel) => (
        <div
          class="release-view"
          data-release-view
          data-release-tag={panel.release.tag_name}
          hidden={!panel.isLatest}
        >
          <div class="release-header">
            <p class="eyebrow">{labels.currentVersion}</p>
            <h2 class="release-version">
              {panel.release.tag_name}
              {panel.isLatest ? <span class="release-badge latest">{labels.latestBadge}</span> : null}
              {panel.release.prerelease ? <span class="release-badge pre">{labels.prereleaseBadge}</span> : null}
            </h2>
            {panel.date ? <p class="release-date">{labels.published}: {panel.date}</p> : null}
          </div>

          <div class="release-layout">
            {/* ── Assets column ── */}
            <div class="release-assets">
              <h3 class="release-section-title">{labels.assets}</h3>
              {panel.assets.length > 0 ? (
                <div class="download-list">
                  {panel.assets.map((asset) => (
                    <a class="download-card" href={asset.browser_download_url} target="_blank" rel="noopener noreferrer" data-download-asset>
                      <span class="download-icon" aria-hidden="true">{iconForAsset(asset.name)}</span>
                      <span class="download-info">
                        <strong>{asset.name}</strong>
                        <span class="download-size">{`${sizeFormatter.format(Math.max(1, Math.round(asset.size / 1024 / 1024)))}\u00a0MB`}</span>
                      </span>
                      <span class="download-arrow" aria-hidden="true">↓</span>
                    </a>
                  ))}
                </div>
              ) : <p>{labels.noAssets}</p>}
              <aside class="platform-note">
                <strong><span aria-hidden="true">🤖</span> {labels.androidTitle}</strong>
                <p>{labels.androidBody}</p>
              </aside>
              <div class="hero-actions" style="margin-top: 1.25rem;">
                <a class="button-link" href={panel.release.html_url}>{labels.open}</a>
              </div>
            </div>

            {/* ── Release notes column ── */}
            {panel.bodyHtml ? (
              <div class="release-notes-panel">
                <h3 class="release-section-title">{labels.notes}</h3>
                <div class="release-notes-scroll">
                  <div class="release-notes-body" set:html={panel.bodyHtml} />
                </div>
              </div>
            ) : null}
          </div>
        </div>
      ))}

      {releases.length > 1 ? (
        <div class="older-releases">
          <h3 class="release-section-title">{labels.olderTitle}</h3>
          <p class="older-hint">{labels.olderHint}</p>
          <div class="version-chip-list">
            {releases.slice(1).map((release) => (
              <a
                class="version-chip"
                href={release.html_url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {release.tag_name}
                {release.prerelease ? <span class="version-chip-tag pre">{labels.prereleaseBadge}</span> : null}
              </a>
            ))}
          </div>
        </div>
      ) : null}

      <aside class="support-panel" aria-labelledby="support-title">
        <h3 id="support-title">{labels.supportTitle}</h3>
        <p>{labels.supportText}</p>
        <p class="support-disclaimer">{labels.supportDisclaimer}</p>
        <a class="button-link primary" href={donationUrl} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">☕</span> {labels.supportAction}</a>
      </aside>
    </>
  ) : (
    <>
      <p>{labels.fallback}</p>
      {error ? <p style="color: #ffe2ab;">{error}</p> : null}
      <div class="hero-actions">
        <a class="button-link primary" href={releaseUrl}>{labels.open}</a>
      </div>
    </>
  )}
</section>

<dialog class="donation-dialog" data-donation-dialog>
  <div class="donation-dialog-body">
    <h3>{labels.downloadThanks}</h3>
    <p>{labels.downloadSupportText}</p>
    <p class="support-disclaimer">{labels.supportDisclaimer}</p>
    <div class="donation-dialog-actions">
      <a class="button-link primary" href={donationUrl} target="_blank" rel="noopener noreferrer" data-donation-close><span aria-hidden="true">☕</span> {labels.supportAction}</a>
      <button type="button" class="button-link" data-donation-close>{labels.downloadClose}</button>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector("[data-donation-dialog]");

  function showDonationReminder() {
    if (!(dialog instanceof HTMLDialogElement) || dialog.open) return;
    dialog.showModal();
  }

  function bindDownloadLinks() {
    document.querySelectorAll<HTMLAnchorElement>("[data-download-asset]").forEach((link) => {
      if (link.dataset.bound === "1") return;
      link.dataset.bound = "1";
      link.addEventListener("click", (event) => {
        if (!(link instanceof HTMLAnchorElement)) return;
        if (event.defaultPrevented) return;
        // Modifier-clicks / middle-click open in a new tab — let the browser
        // handle them without intercepting.
        const mouseEvent = event as MouseEvent;
        if (mouseEvent.button !== 0 || mouseEvent.metaKey || mouseEvent.ctrlKey || mouseEvent.shiftKey || mouseEvent.altKey) return;
        // Following the download URL in the same tab can move the page away
        // before the modal paints. Keep LibreTracks open, show the reminder,
        // and let the browser handle the GitHub asset separately.
        event.preventDefault();
        showDonationReminder();
        window.open(link.href, "_blank", "noopener,noreferrer");
      });
    });
  }

  bindDownloadLinks();

  const closeButtons = document.querySelectorAll("[data-donation-close]");
  closeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      if (dialog instanceof HTMLDialogElement) dialog.close();
    });
  });

  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) {
      dialog.close();
    }
  });
</script>
