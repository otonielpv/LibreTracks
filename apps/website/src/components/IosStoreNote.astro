---
interface Props {
  lang: "en" | "es";
}

const { lang } = Astro.props;
const isSpanish = lang === "es";

// Unlike Android, iOS is live in its store, so this note links straight to
// the listing. The Spanish page points at the Spanish storefront; the English
// one uses the region-neutral URL so Apple redirects to the visitor's store.
const appStoreUrl = isSpanish
  ? "https://apps.apple.com/es/app/libretracks/id6811346212"
  : "https://apps.apple.com/app/libretracks/id6811346212";

const copy = {
  iosTitle: isSpanish ? "iOS: disponible en el App Store" : "iOS: available on the App Store",
  iosBody: isSpanish
    ? "LibreTracks para iPhone y iPad se instala desde el App Store y se actualiza solo con cada versión nueva."
    : "LibreTracks for iPhone and iPad installs from the App Store and updates itself with every new version.",
  iosBadgeTop: isSpanish ? "Consíguelo en el" : "Download on the",
  iosBadgeAria: isSpanish ? "Descargar LibreTracks en el App Store" : "Download LibreTracks on the App Store",
};
---

<aside class="platform-note">
  <strong><span aria-hidden="true">📱</span> {copy.iosTitle}</strong>
  <p>{copy.iosBody}</p>
  <a class="store-badge" href={appStoreUrl} target="_blank" rel="noopener noreferrer" aria-label={copy.iosBadgeAria}>
    <svg class="store-badge-logo" viewBox="0 0 384 512" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z" />
    </svg>
    <span class="store-badge-text">
      <span class="store-badge-top">{copy.iosBadgeTop}</span>
      <span class="store-badge-name">App Store</span>
    </span>
  </a>
</aside>
