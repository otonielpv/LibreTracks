---
interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;
const isSpanish = lang === "es";
const labels = isSpanish
  ? {
      loading: "Cargando metricas de uso...",
      unavailable: "Las metricas no estan disponibles en este momento.",
      appStarts: "Inicios de la aplicacion",
      devices: "Dispositivos activos aproximados",
      deviceDays: "Dispositivos-día",
      last24Hours: "Ultimas 24 horas",
      last7Days: "Ultimos 7 dias",
      last30Days: "Ultimos 30 dias",
      hourlyTitle: "Actividad por hora",
      hourlySubtitle: "Ultimas 24 horas, agrupadas en UTC",
      dailyTitle: "Evolucion diaria",
      dailySubtitle: "Ultimos 30 dias naturales en UTC",
      starts: "Inicios",
      activeDevices: "Dispositivos",
      versions: "Versiones",
      countries: "Paises",
      operatingSystems: "Sistemas operativos",
      architectures: "Arquitecturas",
      deviceClasses: "Tipos de dispositivo",
      breakdownSubtitle: "Distribucion de los ultimos 30 dias",
      empty: "Aun no hay suficientes datos para mostrar este desglose.",
      suppressed: "Dato oculto: menos de 5 dispositivos",
      unknownCountry: "Pais desconocido",
      updated: "Actualizado",
    }
  : {
      loading: "Loading usage metrics...",
      unavailable: "Usage metrics are currently unavailable.",
      appStarts: "App starts",
      devices: "Approximate active devices",
      deviceDays: "Device-days",
      last24Hours: "Last 24 hours",
      last7Days: "Last 7 days",
      last30Days: "Last 30 days",
      hourlyTitle: "Activity by hour",
      hourlySubtitle: "Last 24 hours, grouped in UTC",
      dailyTitle: "Daily trend",
      dailySubtitle: "Last 30 UTC calendar days",
      starts: "Starts",
      activeDevices: "Devices",
      versions: "Versions",
      countries: "Countries",
      operatingSystems: "Operating systems",
      architectures: "Architectures",
      deviceClasses: "Device types",
      breakdownSubtitle: "Distribution over the last 30 days",
      empty: "There is not enough data to show this breakdown yet.",
      suppressed: "Hidden: fewer than 5 devices",
      unknownCountry: "Unknown country",
      updated: "Updated",
    };
---

<section
  class="usage-stats"
  data-usage-stats
  data-lang={lang}
  data-labels={JSON.stringify(labels)}
  aria-busy="true"
>
  <p class="stats-muted" data-usage-status>{labels.loading}</p>
  <div class="usage-summary" data-usage-summary aria-live="polite"></div>
  <div class="usage-charts" data-usage-charts></div>
  <div class="usage-breakdowns" data-usage-breakdowns></div>
</section>

<script>
  type Count = { sessions: number; devices: number };
  type Row = { label: string; sessions: number; devices: number };
  type TimelineRow = Count & { period: string; suppressed: boolean };
  type Stats = {
    generatedAt: string;
    minimumPublicCohort: number;
    metrics: {
      last24Hours: Count;
      last7Days: Count;
      last30Days: Count;
    };
    timeline: { hourly: TimelineRow[]; daily: TimelineRow[] };
    breakdown: Record<string, Row[]>;
  };

  const root = document.querySelector<HTMLElement>("[data-usage-stats]");
  const status = root?.querySelector<HTMLElement>("[data-usage-status]");
  const summary = root?.querySelector<HTMLElement>("[data-usage-summary]");
  const charts = root?.querySelector<HTMLElement>("[data-usage-charts]");
  const breakdowns = root?.querySelector<HTMLElement>("[data-usage-breakdowns]");
  const labels = JSON.parse(root?.dataset.labels ?? "{}") as Record<string, string>;
  const locale = root?.dataset.lang ?? "en";
  const formatter = new Intl.NumberFormat(locale);
  const countryNames =
    typeof Intl.DisplayNames === "function"
      ? new Intl.DisplayNames([locale], { type: "region" })
      : null;

  function summaryCard(period: string, data: Count, deviceLabel: string): HTMLElement {
    const card = document.createElement("article");
    const heading = document.createElement("span");
    const metrics = document.createElement("div");
    heading.className = "usage-summary-period";
    heading.textContent = period;
    metrics.className = "usage-summary-values";
    [
      [data.sessions, labels.appStarts],
      [data.devices, deviceLabel],
    ].forEach(([value, label]) => {
      const item = document.createElement("div");
      const strong = document.createElement("strong");
      const span = document.createElement("span");
      strong.textContent = formatter.format(value as number);
      span.textContent = label as string;
      item.append(strong, span);
      metrics.append(item);
    });
    card.append(heading, metrics);
    return card;
  }

  function chart(
    title: string,
    subtitle: string,
    rows: TimelineRow[],
    unit: "hour" | "day",
  ): HTMLElement {
    const card = document.createElement("article");
    card.className = "usage-chart-card";
    const header = document.createElement("header");
    const copy = document.createElement("div");
    const heading = document.createElement("h3");
    const detail = document.createElement("p");
    const legend = document.createElement("div");
    heading.textContent = title;
    detail.textContent = subtitle;
    legend.className = "usage-chart-legend";
    legend.innerHTML = `<span><i class="starts"></i>${labels.starts}</span><span><i class="devices"></i>${labels.activeDevices}</span>`;
    copy.append(heading, detail);
    header.append(copy, legend);

    const scroll = document.createElement("div");
    const plot = document.createElement("div");
    scroll.className = "usage-chart-scroll";
    plot.className = `usage-chart-plot usage-chart-${unit}`;
    const max = Math.max(1, ...rows.flatMap((row) => [row.sessions, row.devices]));

    rows.forEach((row, index) => {
      const column = document.createElement("div");
      const bars = document.createElement("div");
      const starts = document.createElement("i");
      const devices = document.createElement("i");
      const tick = document.createElement("span");
      const date = new Date(unit === "hour" ? row.period : `${row.period}T00:00:00Z`);
      const periodLabel =
        unit === "hour"
          ? new Intl.DateTimeFormat(locale, { hour: "2-digit", minute: "2-digit", timeZone: "UTC" }).format(date)
          : new Intl.DateTimeFormat(locale, { day: "2-digit", month: "short", timeZone: "UTC" }).format(date);
      column.className = row.suppressed ? "usage-chart-column suppressed" : "usage-chart-column";
      bars.className = "usage-chart-bars";
      starts.className = "starts";
      devices.className = "devices";
      starts.style.height = `${(row.sessions / max) * 100}%`;
      devices.style.height = `${(row.devices / max) * 100}%`;
      tick.textContent = index % (unit === "hour" ? 3 : 5) === 0 ? periodLabel : "";
      column.title = row.suppressed
        ? `${periodLabel}: ${labels.suppressed}`
        : `${periodLabel}: ${formatter.format(row.sessions)} ${labels.starts.toLowerCase()}, ${formatter.format(row.devices)} ${labels.activeDevices.toLowerCase()}`;
      column.setAttribute("aria-label", column.title);
      bars.append(starts, devices);
      column.append(bars, tick);
      plot.append(column);
    });
    scroll.append(plot);
    card.append(header, scroll);
    return card;
  }

  function displayLabel(section: string, value: string): string {
    if (section !== "countries") return value;
    if (value === "XX") return labels.unknownCountry;
    return countryNames?.of(value) ?? value;
  }

  function breakdown(title: string, section: string, rows: Row[]): HTMLElement {
    const card = document.createElement("article");
    card.className = "usage-breakdown-card";
    const heading = document.createElement("h3");
    const subtitle = document.createElement("p");
    heading.textContent = title;
    subtitle.textContent = labels.breakdownSubtitle;
    card.append(heading, subtitle);

    if (rows.length === 0) {
      const empty = document.createElement("p");
      empty.className = "stats-muted";
      empty.textContent = labels.empty;
      card.append(empty);
      return card;
    }

    const max = Math.max(...rows.map((row) => row.devices), 1);
    rows.forEach((row) => {
      const line = document.createElement("div");
      const name = document.createElement("span");
      const value = document.createElement("strong");
      const bar = document.createElement("i");
      line.className = "usage-breakdown-row";
      name.textContent = displayLabel(section, row.label);
      value.textContent = `${formatter.format(row.devices)} · ${formatter.format(row.sessions)}`;
      value.title = `${formatter.format(row.devices)} ${labels.deviceDays.toLowerCase()}, ${formatter.format(row.sessions)} ${labels.starts.toLowerCase()}`;
      bar.style.width = `${Math.max(3, (row.devices / max) * 100)}%`;
      line.append(name, value, bar);
      card.append(line);
    });
    return card;
  }

  async function loadUsageStats(): Promise<void> {
    try {
      const response = await fetch("/api/telemetry/stats");
      if (!response.ok) throw new Error(String(response.status));
      const data = (await response.json()) as Stats;

      summary?.append(
        summaryCard(labels.last24Hours, data.metrics.last24Hours, labels.devices),
        summaryCard(labels.last7Days, data.metrics.last7Days, labels.deviceDays),
        summaryCard(labels.last30Days, data.metrics.last30Days, labels.deviceDays),
      );
      charts?.append(
        chart(labels.hourlyTitle, labels.hourlySubtitle, data.timeline.hourly, "hour"),
        chart(labels.dailyTitle, labels.dailySubtitle, data.timeline.daily, "day"),
      );
      [
        [labels.countries, "countries"],
        [labels.versions, "versions"],
        [labels.operatingSystems, "operatingSystems"],
        [labels.deviceClasses, "deviceClasses"],
        [labels.architectures, "architectures"],
      ].forEach(([title, section]) =>
        breakdowns?.append(
          breakdown(title, section, data.breakdown[section] ?? []),
        ),
      );
      if (status) {
        const date = new Intl.DateTimeFormat(locale, {
          dateStyle: "medium",
          timeStyle: "short",
          timeZone: "UTC",
        }).format(new Date(data.generatedAt));
        status.textContent = `${labels.updated}: ${date} UTC`;
      }
    } catch {
      if (status) status.textContent = labels.unavailable;
    } finally {
      root?.setAttribute("aria-busy", "false");
    }
  }

  void loadUsageStats();
</script>
