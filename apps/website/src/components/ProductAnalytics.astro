---
import { analyticsCopy } from "./analytics/copy";

interface Props {
  lang?: "en" | "es";
}

const { lang = "es" } = Astro.props;
const copy = analyticsCopy(lang);
---

<script is:inline>
  (() => {
    const url = new URL(window.location.href);
    if (!url.searchParams.has("token")) return;
    url.searchParams.delete("token");
    window.history.replaceState(null, "", `${url.pathname}${url.search}${url.hash}`);
  })();
</script>

<section class="product-analytics" data-product-analytics data-lang={lang} data-copy={JSON.stringify(copy)}>
  <div class="analytics-login" data-analytics-login>
    <h3>{copy.access}</h3>
    <label>
      <span>{copy.token}</span>
      <input type="password" data-analytics-token autocomplete="current-password" minlength="15" required />
    </label>
    <button class="button-link" type="button" data-analytics-submit>{copy.enter}</button>
  </div>
  <div class="analytics-toolbar" data-analytics-toolbar hidden>
    <div class="analytics-range" role="group" aria-label={copy.rangeTitle}>
      <button type="button" class="analytics-range-step" data-range-step="-1" title={copy.previousRange} aria-label={copy.previousRange}>&#8249;</button>
      <button type="button" class="analytics-range-trigger" data-range-trigger aria-haspopup="dialog" aria-expanded="false">
        <span aria-hidden="true">&#128337;</span>
        <span data-range-label>{copy.range_last30d}</span>
        <i aria-hidden="true">&#9662;</i>
      </button>
      <button type="button" class="analytics-range-step" data-range-step="1" title={copy.nextRange} aria-label={copy.nextRange}>&#8250;</button>
      <button type="button" class="analytics-range-step" data-range-refresh title={copy.refresh} aria-label={copy.refresh}>&#10227;</button>
      <div class="analytics-range-popover" data-range-popover role="dialog" aria-label={copy.rangeTitle} hidden>
        <div class="analytics-range-quick">
          <h4>{copy.quickRanges}</h4>
          <ul data-range-presets></ul>
        </div>
        <div class="analytics-range-absolute">
          <h4>{copy.absoluteRange}</h4>
          <label>
            <span>{copy.rangeFrom}</span>
            <input type="datetime-local" data-range-from />
          </label>
          <label>
            <span>{copy.rangeTo}</span>
            <input type="datetime-local" data-range-to />
          </label>
          <p class="analytics-range-error" data-range-error hidden></p>
          <button type="button" class="button-link" data-range-apply>{copy.rangeApply}</button>
          <p class="stats-muted">{copy.retentionNote}</p>
        </div>
      </div>
    </div>
    <div class="analytics-toolbar-end">
      <button type="button" class="analytics-lock" data-analytics-tokens hidden>{copy.tokensOpen}</button>
      <button type="button" class="analytics-lock" data-analytics-lock>{copy.exit}</button>
    </div>
  </div>
  <p class="stats-muted analytics-filters-hint" data-analytics-hint hidden>{copy.filtersHint}</p>
  <div class="analytics-filters" data-analytics-filters role="group" aria-label={copy.filtersTitle} hidden></div>
  <div data-analytics-tokens-host></div>
  <p class="stats-muted" data-analytics-status></p>
  <div data-analytics-content></div>
</section>

<script>
  import "./analytics/dashboard";
</script>
