<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Foreground media service: keeps the AAudio stream alive with the
         screen off / app backgrounded. MEDIA_PLAYBACK type is mandatory on
         API 34+; POST_NOTIFICATIONS lets the pinned notification show on 13+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- No storage permissions, deliberately. Google Play only grants
         MANAGE_EXTERNAL_STORAGE to file managers, backup and anti-virus apps,
         so a DAW cannot ship with it. Sessions therefore live in the app's own
         external dir (see project_root), which needs no permission, and audio,
         .ltset and .ltpkg still come in and out through the system picker —
         that has never needed a permission either. What this costs is
         open-session-in-place on an arbitrary folder: the engine streams audio
         by real path and Android's folder grants hand back content:// URIs.
         FL Studio Mobile and Audio Evolution both made the same trade.
         Do NOT "fix" this by re-adding the permission. -->

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.libretracks_desktop"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- sensorLandscape: the DAW surface (timeline + mixer) is unusable in
             portrait on a phone; lock to landscape but allow both rotations. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
          android:name=".AudioPlaybackService"
          android:exported="false"
          android:foregroundServiceType="mediaPlayback" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
