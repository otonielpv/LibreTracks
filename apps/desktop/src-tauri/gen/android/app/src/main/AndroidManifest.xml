<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Network sessions (docs/plans/network-sessions, paso 04): finding a
         host by mDNS needs a Wi-Fi MulticastLock, or Android drops the
         multicast answers. Normal permission, granted at install. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- MIDI (MidiBridge.kt). required="false" so Play still lists the app on
         devices without android.media.midi; MidiBridge.isAvailable checks. -->
    <uses-feature android:name="android.software.midi" android:required="false" />
    <!-- Bluetooth LE MIDI pedals (plan mobile-midi, paso 06). Asked at run time
         only when the user presses "Search Bluetooth devices" in Settings > MIDI.
         Android 12+: SCAN (neverForLocation: we only look for the MIDI service
         UUID, never derive location) + CONNECT. Android 11 and older: BLE scans
         need location; BLUETOOTH/BLUETOOTH_ADMIN are install-time there. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <!-- Foreground media service: keeps the AAudio stream alive with the
         screen off / app backgrounded. MEDIA_PLAYBACK type is mandatory on
         API 34+; POST_NOTIFICATIONS lets the pinned notification show on 13+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- No storage permissions, deliberately. Google Play only grants
         MANAGE_EXTERNAL_STORAGE to file managers, backup and anti-virus apps,
         so a DAW cannot ship with it. Sessions therefore live in the app's own
         external dir (see project_root), which needs no permission, and audio,
         .ltset and .ltpkg still come in and out through the system picker —
         that has never needed a permission either. What this costs is
         open-session-in-place on an arbitrary folder: the engine streams audio
         by real path and Android's folder grants hand back content:// URIs.
         FL Studio Mobile and Audio Evolution both made the same trade.
         Do NOT "fix" this by re-adding the permission. -->

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.libretracks_desktop"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- sensorLandscape: the DAW surface (timeline + mixer) is unusable in
             portrait on a phone; lock to landscape but allow both rotations. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
            <intent-filter >
                <action android:name="android.intent.action.VIEW" />
                <!-- ChromeOS ARC++ uses a different action for deep links -->
                <action android:name="org.chromium.arc.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.googleusercontent.apps.809304051758-k6cr7mg3eqf1dentv3ggffuvcfadt9pf" />
                <data android:scheme="com.googleusercontent.apps.809304051758-o6bh7njdsj1d0596u1n0skpqasn4pr8q" />
                <data android:scheme="com.googleusercontent.apps.809304051758-ekp6mq7miacmd1qtjej20tqv2grhs68d" />
                
                
                
                
                
            </intent-filter>
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
        </activity>

        <service
          android:name=".AudioPlaybackService"
          android:exported="false"
          android:foregroundServiceType="mediaPlayback" />

        <!-- LibreTracks as a MIDI device for other apps on this phone (plan
             mobile-midi, paso 10). Disabled here: MidiBridge.setVirtualPortEnabled
             turns the component on with the "Publish LibreTracks virtual MIDI
             port" setting, so while it is off no app sees a LibreTracks device. -->
        <service
          android:name=".LtVirtualMidiService"
          android:enabled="false"
          android:exported="true"
          android:permission="android.permission.BIND_MIDI_DEVICE_SERVICE">
          <intent-filter>
            <action android:name="android.media.midi.MidiDeviceService" />
          </intent-filter>
          <meta-data
            android:name="android.media.midi.MidiDeviceService"
            android:resource="@xml/lt_virtual_midi" />
        </service>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
